{
	"Launch Joint" "Right Elbow" //was "N/A"
}
+Link -175 -676 "AIProjectile" 02E00000 //OG-Shotgun -> Grunt Shotgun Slug
{
	"Launch Joint" "Right Shoulder" //was "Right Fingers"
}
+Link -179 -1603 "AIProjectile" 02E00002 //Midwife -> Midwife Shot
{
	"Launch Joint" "Right Shoulder" //was "Right Fingers"
}
+Link -1541 -2824 "AIProjectile" 02E0000B //Assassin -> Ninja Shot
{
	"Launch Joint" "Right Wrist" //"Left Elbow" //was "Right Wrist"
}
